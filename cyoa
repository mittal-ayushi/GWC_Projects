let enterButton;
let a1Button;
let a2Button;
let b1Button;
let b2Button;
let exploreButton;
let continueButton;
let screen = 0;
let bg;
let color;
let buttonColor = "white";
let House;
let yes;
let no;


function preload() {
  // Load the background image
  bg = loadImage("hogwarts.jpg");
}

function setup() {
  textFont("Oswald");
  createCanvas(windowWidth, windowHeight);
  textAlign(CENTER);
  noStroke();

  // Set up the home screen with Hogwarts background image
  background(bg);
  textSize(30); // Set the text color to white
  text("Welcome to Hogwarts", width / 2, 50); // Center the text horizontally
  textSize(20);
  enterButton = new Sprite(width / 2, height / 2 + 120);
  a1Button = new Sprite(-100, -100);
  a2Button = new Sprite(-100, -100);
  b1Button = new Sprite(-100, -100);
  b2Button = new Sprite(-100, -100);
  yes = new Sprite(-100, -100);
  no = new Sprite(-100, -100);
  exploreButton = new Sprite(-100, -100);
  continueButton = new Sprite(-100, -100);
}
function draw() {
  //Draw enter button
  enterButton.w = 175;
  enterButton.h = 60;
  enterButton.collider = "k";
  enterButton.text = "Start the Adventure";
  enterButton.color = buttonColor;


  fill("white");

  // Check enter button
  if (enterButton.mouse.presses()) {
    showScreen1();
    screen = 1;
  }

  if (screen == 1) {
    if (a1Button.mouse.presses()) {
      color = 'green';
      showScreen2();
      screen = 2;
      b1Button.text = "Draco Malfoy"
      b2Button.text = "Prof. Snape"
      House = "Slytherin";
    } else if (a2Button.mouse.presses()) {
      color = '#00008B';
      House = "Ravenclaw";
      showScreen2();
      screen = 2;
      b1Button.text = "Luna Lovegood"
      b2Button.text = "Prof. Flitwick"
    }
  }
  else if (screen == 2) {
    if (b1Button.mouse.presses()) {
      showScreen3();
      screen = 3;
    }
    else if (b2Button.mouse.presses()) {
      showScreen4();
      screen = 4;
    }
  }
  else if (screen == 3) {
    if (yes.mouse.presses()) {
      showScreen5();
      screen = 5;
    } else if (no.mouse.presses()) {
      showScreen6();
      screen = 6;
    }
  } else if (screen == 5) {
    if (exploreButton.mouse.presses()) {
      showScreen7();
      screen = 7;
    }
    if (continueButton.mouse.presses()) {
      showScreen8();
      screen = 8;
    }
  }
  else if (screen == 6) {
    if (continueButton.mouse.presses()) {
      showScreen8();
      screen = 8;
    }
  } 
    else if (screen == 7) {
    if (b1Button.mouse.presses()) {
      showScreen9();
      screen = 9;
    } else if (b2Button.mouse.presses()) {
      showScreen10();
      screen = 10;
    }
  } else if (screen == 8) {
    if (b1Button.mouse.presses()) {
      showScreen11();
      screen = 11;
    } 
    else if (b2Button.mouse.presses()) {
      showScreen12();
      screen = 12;
    }
  }

  print(screen);
}

